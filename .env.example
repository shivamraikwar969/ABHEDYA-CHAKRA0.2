# ---- RakshakAI security configuration (copy to .env, NEVER commit the real file) ----
# AES-256 key ring, first entry is active; older entries only decrypt (key rotation). Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RAKSHAK_KEYS=k1:REPLACE_WITH_32_BYTE_BASE64
NODE_ENV=production
REQUIRE_AUTH=1                 # narrate/dossier require a signed-in session (vault + auth routes always do)
REQUIRE_ARGON2=1               # refuse to start without the argon2 package
# Behind Vercel / nginx only (1 = one trusted proxy hop). Leave unset when exposed directly.
TRUSTED_PROXY_HOPS=1
# Shared rate-limit counters across all serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Tuning (defaults shown)
RATE_PER_MIN=120
LLM_DAILY_BUDGET=2000
LLM_MAX_CONCURRENT=2
SESSION_TTL_SEC=3600
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4
